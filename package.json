{
  "name": "@local/dsh-locale-vi",
  "version": "1.1.0",
  "private": true,
  "description": "Adds the Vietnamese (vi) language to the DeepSeek Harness Web GUI, including installed-package titles and descriptions.",
  "type": "module",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "plugin/index.js",
    "plugin/client.js",
    "plugin/cordis.patch.yml",
    "plugin/locale/*.json",
    "plugin/icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
